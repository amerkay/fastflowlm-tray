# FastFlowLM server, supervised by the systemd *user* manager.
# Installed by ./install.sh, which copies this file to ~/.config/systemd/user/
# and rewrites the ExecStart binary to wherever `flm` actually lives. Re-run
# install.sh after editing; the installed copy is a copy, not a symlink.
#
# Deliberately NOT enabled and has no [Install] section: the server only runs
# when started from the tray. `systemctl --user enable` will refuse, by design.
#
# ExecStart must be an ABSOLUTE path: the user manager's PATH does not
# include ~/.local/bin.
#
# Flags: no --host (localhost only), --cors 0 also blocks a browser page from
# reaching 127.0.0.1:52625.

[Unit]
Description=FastFlowLM server

[Service]
# The model and context are whatever the tray last wrote. Environment= first,
# EnvironmentFile= second, so the file wins; the leading `-` makes a missing file
# fall back to these defaults instead of starting `flm serve` with empty
# arguments. FLM_CTX=32768 is FastFlowLM's own default context length.
Environment=FLM_MODEL=gemma4-it:e2b
Environment=FLM_CTX=32768
Environment=FLM_ASR=0
EnvironmentFile=-%h/.config/flm-tray/env
ExecStart=/usr/bin/flm serve ${FLM_MODEL} --ctx-len ${FLM_CTX} --asr ${FLM_ASR} --pmode turbo --cors 0

# NPU workloads pin their weights; a Plasma-session child inherits the PAM
# memlock limit instead and fails at model load. This is why the tray does
# not spawn flm itself.
LimitMEMLOCK=infinity

# Skip the pre-run version check: no network round-trip gating a start.
Environment=FLM_DISABLE_UPDATE_CHECK=1

Restart=on-failure
RestartSec=5
# Unloading ~20 GB is not instant; SIGKILL mid-unload can leave the XRT
# context wedged ("No such device with index '0'" on the next start).
TimeoutStopSec=60
