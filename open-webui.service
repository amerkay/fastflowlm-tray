# Runs compose.yaml in the foreground so its logs land in the journal.
# install.sh fills in the docker and compose paths.

[Unit]
Description=Open WebUI for FastFlowLM

[Service]
EnvironmentFile=%E/flm-tray/searxng.env
ExecStart=/usr/bin/docker compose -f @COMPOSE@ up --abort-on-container-exit
# Keeps the unit "activating" until the UI answers.
ExecStartPost=/bin/sh -c 'until /usr/bin/docker compose -f @COMPOSE@ exec -T open-webui curl -sf http://127.0.0.1:8080/health >/dev/null; do sleep 2; done'
ExecStop=/usr/bin/docker compose -f @COMPOSE@ down
TimeoutStartSec=600
